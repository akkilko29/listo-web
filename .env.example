# Copy to .env and change for each environment.
# Leave empty in local Vite to use the /api proxy in vite.config.js.
VITE_API_BASE_URL=http://localhost:8080

# Optional store listings shown in the header download buttons.
VITE_ANDROID_APP_URL=https://play.google.com/store/apps
VITE_IOS_APP_URL=https://apps.apple.com
