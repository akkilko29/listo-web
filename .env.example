# Copy to .env and change for each environment.
# Production API origin. Local Vite still proxies /api through vite.config.js.
VITE_API_BASE_URL=https://listolisting.online

# Google Sign-In web client ID
VITE_GOOGLE_CLIENT_ID=1030081817796-fns1lbfckj4da27kqhm1942qsccctqqa.apps.googleusercontent.com

# Public site origin used in canonical URLs, Open Graph tags, robots and sitemap.
VITE_SITE_URL=https://listolisting.in

# Optional store listings shown in the header download buttons.
VITE_ANDROID_APP_URL=https://play.google.com/store/apps
VITE_IOS_APP_URL=https://apps.apple.com
